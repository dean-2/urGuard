# urGuard Environment Configuration
# Copy to .env for local overrides. Do NOT commit .env or any secret material.
# Keys, certificates, and backup passphrases are generated or supplied at runtime.

# Service Ports
URGUARD_CONTROLPLANE_PORT=8080
URGUARD_NODE_A_PORT=8081
URGUARD_NODE_B_PORT=8082
URGUARD_NODE_C_PORT=8083
URGUARD_FRONTEND_PORT=5173
URGUARD_PROXY_PORT=8443

# Service URLs
URGUARD_CONTROLPLANE_URL=http://localhost:8080
URGUARD_NODE_A_URL=http://localhost:8081
URGUARD_NODE_B_URL=http://localhost:8082
URGUARD_NODE_C_URL=http://localhost:8083
URGUARD_NODE_URLS=http://localhost:8081,http://localhost:8082,http://localhost:8083

# Cryptographic Lifecycle & Detection Bounds
URGUARD_ROTATION_GRACE_SEC=30
URGUARD_MAX_CLOCK_SKEW_SEC=30
URGUARD_CRL_HEARTBEAT_SEC=1
URGUARD_LOG_CHECKPOINT_INTERVAL=50

# Runtime Storage & Ephemeral TLS Directories (no committed certs)
URGUARD_DATA_DIR=./data
URGUARD_RUNTIME_CERT_DIR=./certs
URGUARD_TLS_MODE=pqc-mtls

# Module 5 backend. For TLS use https service URLs and certificates with
# client common names controlplane, admin, node:<node-id> or device:<device-id>.
URGUARD_CP_ADDR=127.0.0.1:8080
URGUARD_NODE_ADDR=127.0.0.1:8081
URGUARD_CP_DB_PATH=controlplane.bbolt
URGUARD_NODE_ID=node-1
URGUARD_NODE_DB_PATH=node-1.bbolt
URGUARD_REQUIRED_NODES=node-1,node-2,node-3
# Set this to the chosen independent relay, e.g. http://127.0.0.1:8081
# for loopback h2c. An empty URL is for deployments without witness enrollment.
URGUARD_WITNESS_URL=
URGUARD_WITNESS_DB_PATH=node-1.witness.bbolt
# The control plane writes this public pin on its first launch. Distribute it
# to each relay via a trusted channel. Start the witness with that pin, then
# start/restart the control plane with WITNESS_URL set. Use distinct per-node
# addresses and DB paths, and keep the witness DB outside control-plane restores.
URGUARD_AUTHORITY_PUBLIC_FILE=authority.pub
URGUARD_CRL_HEARTBEAT_MS=1000
URGUARD_CHECKPOINT_INTERVAL=25
URGUARD_BACKUP_PASSPHRASE=
URGUARD_TLS_CERT_FILE=
URGUARD_TLS_KEY_FILE=
URGUARD_TLS_CA_FILE=
# Loopback h2c matches the HTTP URLs above. Inject distinct random tokens
# (32+ bytes) as a JSON object mapping principal names to credentials.
URGUARD_CP_GRPC_TLS=false
URGUARD_LOCAL_TOKENS={}

# Frontend Console Configuration
VITE_API_BASE_URL=http://localhost:8080
VITE_USE_MOCKS=true
VITE_ROTATION_GRACE_SEC=30
VITE_MAX_CLOCK_SKEW_SEC=30
